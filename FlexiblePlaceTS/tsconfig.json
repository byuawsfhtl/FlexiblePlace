{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true
  },
  "include": ["src/aligner.ts","src/autoFillLocation.ts","src/combiner.ts","src/combinerColumn.ts","src/compare.ts","src/compareLocationComponents.ts","src/FlexiblePlace.ts","src/getPlaceDescription.ts","src/locationComponent.ts"],
  "exclude": ["node_modules", "dist"]
}
